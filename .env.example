# NexusPanel control-plane configuration.
# The installer deploys this to /etc/nexuspanel/nexuspanel.env (mode 0600).
#
# SECURITY: never put real credentials in any committed file. M-Pesa Daraja
# keys are delivered out-of-band and live only in the server env file and the
# owner's local secrets store; they are scanned for and rejected before push.

NEXUS_DB_DRIVER=sqlite
# NEXUS_DB_DSN= (default: <NEXUS_DATA_DIR>/nexus.db for sqlite; required for postgres)
NEXUS_LISTEN_ADDR=127.0.0.1:8080
NEXUS_SITE_ADDR=127.0.0.1:8081
NEXUS_DATA_DIR=/var/lib/nexuspanel
NEXUS_AGENT_SOCKET=/run/nexuspanel/agent.sock

# M-Pesa Daraja (DEC-006) — placeholders only until the commerce milestone:
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
